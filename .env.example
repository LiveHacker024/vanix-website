# ==============================================================================
# VANIX COMPLETE LEAD MANAGEMENT & AUTOMATION SYSTEM ENVIRONMENT CONFIG
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BUSINESS NOTIFICATION CONTACTS
# ------------------------------------------------------------------------------
# Internal email for new lead alerts and urgent human handoffs
VANIX_LEAD_EMAIL=hackwithkunal@gmail.com

# Internal WhatsApp recipient in international format without '+' (e.g., 919457727770)
VANIX_LEAD_WHATSAPP=919457727770

# ------------------------------------------------------------------------------
# 2. EMAIL NOTIFICATIONS (Resend)
# ------------------------------------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefg

# Verified sender address (e.g., VANIX Inquiries <onboarding@resend.dev> or info@vanix.in)
RESEND_FROM_EMAIL=VANIX Inquiries <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 3. WHATSAPP NOTIFICATIONS & WEBHOOK (Official Meta WhatsApp Cloud API)
# ------------------------------------------------------------------------------
# Meta App Access Token from https://developers.facebook.com/
WHATSAPP_ACCESS_TOKEN=EAAB...your_meta_system_user_token_here

# Meta Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=100000000000000

# Meta Webhook Verification Token (set this in Meta App Dashboard -> WhatsApp -> Configuration)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=vanix_webhook_verify_token_2026

# ------------------------------------------------------------------------------
# 4. DATABASE (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# IMPORTANT: Service Role Secret Key (Server-side ONLY, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 5. ADMIN COMMAND CENTER AUTHENTICATION (Server-side ONLY)
# ------------------------------------------------------------------------------
# Admin portal email
ADMIN_EMAIL=

# Admin portal password
ADMIN_PASSWORD=

# Strong random secret key for signing session JWT tokens (min 32 chars)
ADMIN_SECRET=

# ------------------------------------------------------------------------------
# 6. SITE URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.vanix360.in
